{
  "name": "sansheng-liubu",
  "version": "1.8.0",
  "description": "基于「三省六部制」的极简高质跨环境 AI 研发工作流引擎与 DeepSeek Harness 插件 (Vue 3 + .NET 8 / Core 3.1 深度优化)",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "bin": {
    "sansheng": "./bin/cli.js",
    "sansheng-worker": "./bin/worker.js",
    "sansheng-mcp": "./bin/mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwotwoPiggy/sansheng-liubu.git"
  },
  "bugs": {
    "url": "https://github.com/TwotwoPiggy/sansheng-liubu/issues"
  },
  "homepage": "https://github.com/TwotwoPiggy/sansheng-liubu#readme",
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node --test test/*.spec.mjs",
    "test:unit": "node --test test/*.spec.mjs",
    "test:plugin": "node --test test/plugin.spec.mjs",
    "test:lsp": "node scripts/test-lsp.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "pack:dry": "npm pack --dry-run"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "cordis.yml",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "sansheng.config.json",
    "LITE_DEV_WORKFLOW_SPEC.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "schemastery",
    "ai-agent",
    "workflow",
    "sdlc",
    "subagent",
    "codebase-map",
    "lsp",
    "dotnet",
    "vue3",
    "yongle-dadian"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^3.0.0",
    "@deepseek-ai/dsh-tools": "^1.0.0",
    "@deepseek-ai/schemastery": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "author": "Lemony & Antigravity",
  "license": "MIT"
}
